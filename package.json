{
  "name": "aegis-ai-study",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-monaco.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-monaco.mjs",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:content": "tsx scripts/content/validate.ts",
    "check:labs": "tsx scripts/content/check-labs.ts",
    "test:security": "node --conditions=react-server --import tsx --test tests/security/security.test.ts tests/security/security-defense.test.ts tests/security/security-monitoring.test.ts tests/security/security-runtime.test.ts",
    "bench:security": "node --conditions=react-server --import tsx scripts/security/benchmark.mjs",
    "test:security:http": "node scripts/security/http-smoke.mjs",
    "test:security:python": "python tests/security/security-inventory.test.py && python tests/security/security-collector.test.py",
    "docs:generate": "tsx scripts/docs/generate-curriculum.ts",
    "docs:check": "tsx scripts/docs/generate-curriculum.ts --check && tsx scripts/docs/check-links.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "katex": "^0.18.7",
    "monaco-editor": "0.57.0",
    "next": "16.4.3",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "source-map-js": "^1.2.2"
  }
}
