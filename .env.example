# Copy this file to .env.production.local at the REPO ROOT on the OCI server
# (never commit the real file). Keep it at the repo root, not inside
# .next/standalone — that directory gets deleted and replaced by every
# deploy. ecosystem.config.js reads this file directly and passes the
# values to PM2 as real process env vars (the standalone Next.js server does
# not reliably auto-load .env files the way `next start` does).

# Passcode that unlocks /operator/* (guide, quiz answers, quality log).
# Pick something you can share verbally with yourself / co-organizers only.
OPERATOR_PASSCODE=change-me-before-deploying

# Port the Next.js server listens on (nginx should reverse-proxy to this).
PORT=3000
