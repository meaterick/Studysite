# Copy this file to .env.production.local on the server (never commit the real file).
# Next.js loads .env.production.local automatically for both `next build` and `next start`.

# Passcode that unlocks /operator/* (guide, quiz answers, quality log).
# Pick something you can share verbally with yourself / co-organizers only.
OPERATOR_PASSCODE=change-me-before-deploying

# Port the Next.js server listens on (nginx should reverse-proxy to this).
PORT=3000
