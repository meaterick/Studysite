# For LOCAL development/testing only. Copy to .env.local (or
# .env.production.local if testing a production build locally).
#
# On the OCI server this file is generated automatically by
# .github/workflows/deploy.yml from GitHub Actions secrets — nothing to
# create by hand there. See README "배포" section.

# 세션 쿠키(로그인 상태)를 서명하는 비밀 키. `openssl rand -base64 32`로 생성해서
# 넣으세요. 비워두면 개발용 기본값이 쓰이는데, 배포 시에는 반드시 설정해야
# 합니다 — 안 그러면 아무나 다른 사람의 로그인 쿠키를 위조할 수 있습니다.
SESSION_SECRET=change-me-before-deploying

# (선택) 회원가입 즉시 관리자 권한을 받는 이메일 목록(쉼표로 구분). 비워두면
# "가장 먼저 가입하는 계정"이 자동으로 관리자가 됩니다 — 보통 이 설정 없이
# 운영자 본인이 배포 직후 제일 먼저 가입하면 됩니다.
ADMIN_EMAILS=

# 회원 정보(users.json)를 저장할 디렉터리. 비워두면 프로젝트 루트의 data/를
# 씁니다. 배포 환경에서는 매 배포마다 새로 만들어지는 .next 바깥의 고정
# 디렉터리를 가리켜야 재배포해도 회원 정보가 사라지지 않습니다.
DATA_DIR=

# Port the Next.js app listens on internally (nginx — not this app — is
# what actually terminates TLS on :443 and forwards here).
PORT=3000
